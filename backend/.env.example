# Copy to .env and edit. Never commit .env.
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/evoting_system
# Use a long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=2h
CORS_ORIGIN=http://localhost:5173

# Blockchain (local Hardhat node)
RPC_URL=http://127.0.0.1:8545
# Optional: overrides the address inside src/contracts/Voting.json
CONTRACT_ADDRESS=
# Hardhat account #0 = contract owner. PUBLIC TEST KEY, local chain only.
ADMIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
